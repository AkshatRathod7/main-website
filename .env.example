# DreamSVin — environment (final build, brand book 2026)
# Anything left empty is simply not shown (no invented values).

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dreamsvin.com
NEXT_PUBLIC_CONTACT_EMAIL=grow@dreamsvin.com
NEXT_PUBLIC_WHATSAPP_NUMBER=            # digits only with country code, e.g. 9198XXXXXXXX
NEXT_PUBLIC_CITY=
NEXT_PUBLIC_HOURS=
NEXT_PUBLIC_SERVICE_AREA=
NEXT_PUBLIC_LEGAL_ENTITY=               # e.g. "DreamSVin LLP, Mumbai" (footer + legal pages)
NEXT_PUBLIC_SAME_AS=                    # comma-separated official profiles for Organization schema (LinkedIn etc.)
NEXT_PUBLIC_INSTAGRAM_URL=              # footer social links render only when set
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ── Analytics (cookieless; matches the privacy notice) ───────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=           # e.g. dreamsvin.com — empty = no analytics script

# ── Booking (Cal.com) ────────────────────────────────────────────────────
NEXT_PUBLIC_CAL_LINK=                   # /contact conversation, e.g. dreamsvin/conversation
NEXT_PUBLIC_CAL_LINK_HEALTH_CHECK=      # Health Check walkthrough, e.g. dreamsvin/health-check-walkthrough
NEXT_PUBLIC_CAL_ORIGIN=https://cal.com  # only change for self-hosted Cal.com

# ── Contact form (/api/contact) ──────────────────────────────────────────
CONTACT_WEBHOOK_URL=                    # empty = the DreamSVin leads Google Sheet (Apps Script, see docs/leads.gs)

# ── Health Check (/api/health-check) ─────────────────────────────────────
HEALTH_CHECK_WEBHOOK_URL=
HEALTH_CHECK_WEBHOOK_SECRET=
EMAIL_PROVIDER=resend                   # resend | postmark | none
EMAIL_FROM="DreamSVin <healthcheck@dreamsvin.com>"
EMAIL_REPLY_TO=grow@dreamsvin.com
EMAIL_BCC=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# ── Production rate limiting (both forms) ────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Previews only ────────────────────────────────────────────────────────
NEXT_PUBLIC_LEADS_AUTOREPLY=           # 1 once docs/leads.gs (AUTOREPLY = true) is redeployed: the thank-you screen then says "Check your inbox"
NEXT_PUBLIC_SHOW_DRAFT_QUOTES=          # 1 on review builds to show client quotes that are not yet approved
